# --- OKX API (read-only key) ---
# Публичные данные (тикеры/свечи/OI/фандинг) не требуют ключей.
# Ключ нужен только для чтения открытых позиций (мониторинг TP/SL/ST-flip).
# Права ключа: ТОЛЬКО "Read" (без Trade/Withdraw).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# demo trading (paper) OKX аккаунт -> true, реальный -> false
OKX_DEMO=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Веб-дашборд ---
# На PaaS/Dokploy платформа обычно сама задаёт PORT — он имеет приоритет над WEB_PORT.
WEB_PORT=3000

# --- Персистентность ---
# Куда писать state.json/settings.json. На Dokploy укажи путь примонтированного
# volume (например /app/data), иначе данные потеряются при редеплое.
DATA_DIR=.

# --- Цикл ---
SCREEN_INTERVAL_SEC=120
NO_TRADE_UPDATE_MIN=20
SIGNAL_COOLDOWN_MIN=30
LOSS_STREAK_PAUSE_MIN=45

# --- Фильтры скрининга ---
CHANGE24H_MIN=3
CHANGE24H_MAX=15
OI_MIN_USDT=500000
MIN_VOL24H_USDT=1000000
FUNDING_MAX=0.0005

# --- Индикаторы ---
RSI_PERIOD=14
RSI15_MIN=45
RSI15_MAX=65
RSI1H_MAX=70
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3

# --- Риск-менеджмент по умолчанию ---
DEFAULT_LEVERAGE=7
MAX_LEVERAGE_CAP=20
DEFAULT_MARGIN_USDT=5
MIN_SCORE_TO_SIGNAL=7
